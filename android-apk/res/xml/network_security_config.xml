<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The prototype server runs on plain HTTP over a local Wi-Fi network. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
